{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "oxc.lint.enable": true,
  "oxc.configPath": "oxlint.config.mjs",
  "oxc.fmt.configPath": "oxfmt.config.mjs",
  "eslint.enable": false,
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "cssvar.files": [
    "./node_modules/@mantine/core/styles.css",
    "./theme.ts"
  ],
  "cssvar.extensions": [
    "css",
    "scss",
    "tsx"
  ]
}
